# ─── PawCare AI Backend – Environment Variables ────────────────────────────
# Copy this file to .env and fill in real values.  Never commit the .env file.
# Lines starting with # are comments.  Blank values are shown where the default
# is safe for local development.

# ── Database ────────────────────────────────────────────────────────────────
# REQUIRED. Neon Postgres URL for production, or explicit sqlite:///cases.db
# for local development. App will fail to start if this is unset.
DATABASE_URL=

# ── JWT ─────────────────────────────────────────────────────────────────────
# REQUIRED.  Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Set to "false" in local dev (no HTTPS).  Must be "true" in production.
JWT_COOKIE_SECURE=true

# JWT access token lifetime in hours (default: 4)
JWT_ACCESS_TOKEN_HOURS=4

# ── Fixed admin account ──────────────────────────────────────────────────────
FIXED_ADMIN_USERNAME=
FIXED_ADMIN_PASSWORD=
FIXED_ADMIN_EMAIL=

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
ADMIN_EMAIL=

# ── Rate Limits ───────────────────────────────────────────────────────────────
# Optional per-route rate limits. Defaults shown below.
RATELIMIT_GEOCODE_REVERSE=30/minute
RATELIMIT_NGOS_LIVE_NEARBY=10/minute

# ── Reverse-proxy trust ───────────────────────────────────────────────────────
# Number of trusted reverse-proxy hops between the internet and this process.
# Default: 1  (one Vercel/Render edge layer)
# Set to 0 only when running Flask directly without any proxy (bare-metal dev).
# Must be a non-negative integer — the app refuses to start if the value is
# invalid.  Do NOT set this higher than the actual number of trusted proxies;
# a too-high value lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY_HOPS=1
